{%- comment -%}
  FurBuddies trust / benefits bar (portfolio demo).
  Row of circular icon badges with bold labels on a cream background.
  @example
  <div class="fb-trust"> ... </div>
{%- endcomment -%}
{%- liquid
  assign s = section.settings
-%}
<div
  class="fb-trust"
  style="
    --fb-bg: {{ s.background_color }};
    --fb-badge: {{ s.badge_color }};
    --fb-label: {{ s.label_color }};
    --fb-ink: {{ s.icon_color }};
    --fb-pad-top: {{ s.padding_top }}px;
    --fb-pad-bottom: {{ s.padding_bottom }}px;
  "
>
  <div class="fb-trust__inner">
    <div class="fb-trust__items" role="list">
      {%- for block in section.blocks -%}
        <div class="fb-trust__item" role="listitem" {{ block.shopify_attributes }}>
          <span class="fb-trust__badge" aria-hidden="true">
            {%- case block.settings.icon -%}
              {%- when 'leaf' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6"/></svg>
              {%- when 'gmo' -%}
                <span class="fb-trust__gmo">GMO</span>
              {%- when 'heart' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20.7 4.9 13.6a4.7 4.7 0 0 1 6.6-6.7l.5.5.5-.5a4.7 4.7 0 0 1 6.6 6.7Z"/></svg>
              {%- when 'gut' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10.4 7.3c1.7-1.6 4.5-.9 5.1 1.3.6 2.2-1.2 4.3-3.4 3.7-2.1-.6-3-3.3-1.7-5Z"/><path d="M7 11.8c-1.7-.3-2.6-2.2-1.7-3.7.9-1.6 3-1.6 3.9-.1"/><path d="M13.6 15.9c.4-1.7 2.3-2.7 3.7-1.7 1.5 1 1.3 3.3-.4 4-1.7.7-3.5-.7-3.3-2.3Z"/><circle cx="16.6" cy="7.2" r=".8" fill="currentColor" stroke="none"/><circle cx="6.6" cy="16.4" r=".8" fill="currentColor" stroke="none"/><circle cx="10.2" cy="4.6" r=".7" fill="currentColor" stroke="none"/><circle cx="19" cy="12.8" r=".7" fill="currentColor" stroke="none"/></svg>
              {%- when 'flask' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><g transform="rotate(-18 12 12)"><path d="M9 3h6"/><path d="M10 3v6.6L5.7 17.7a2 2 0 0 0 1.8 3.3h9a2 2 0 0 0 1.8-3.3L14 9.6V3"/><path d="M6 15.5h12"/></g><line x1="4" y1="20" x2="20" y2="4"/></svg>
              {%- when 'truck' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M1 3h15v13H1z"/><path d="M16 8h4l3 3v5h-7"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
              {%- when 'return' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/></svg>
              {%- else -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/></svg>
            {%- endcase -%}
          </span>
          {%- if block.settings.heading != blank -%}
            <p class="fb-trust__label">{{ block.settings.heading | escape }}</p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .fb-trust {
    background: var(--fb-bg, #faf7f2);
  }

  .fb-trust__inner {
    padding-block: var(--fb-pad-top, 64px) var(--fb-pad-bottom, 64px);
  }

  .fb-trust__items {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    align-items: start;
    justify-items: center;
    gap: 32px 16px;
    max-width: 1180px;
    margin-inline: auto;
    padding-inline: 24px;
  }

  .fb-trust__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 20px;
    min-width: 0;
  }

  .fb-trust__badge {
    display: grid;
    place-items: center;
    inline-size: 108px;
    block-size: 108px;
    border-radius: 50%;
    background: var(--fb-badge, #efe5d3);
    color: var(--fb-ink, #000000);
  }

  .fb-trust__badge svg {
    display: block;
    inline-size: 50px;
    block-size: 50px;
  }

  .fb-trust__label {
    margin: 0;
    font-weight: 700;
    font-size: clamp(1rem, 0.4vw + 0.95rem, 1.2rem);
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--fb-label, #8a6a3a);
  }

  .fb-trust__gmo {
    position: relative;
    font-weight: 800;
    font-size: 1.6rem;
    line-height: 1;
    letter-spacing: 0.01em;
    padding-inline: 4px;
    color: var(--fb-ink, #000000);
  }

  .fb-trust__gmo::after {
    content: "";
    position: absolute;
    left: -2px;
    right: -2px;
    top: 50%;
    block-size: 2.5px;
    border-radius: 2px;
    background: var(--fb-ink, #000000);
    transform: translateY(-50%) rotate(-38deg);
  }

  @media screen and (max-width: 989px) {
    .fb-trust__items {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .fb-trust__badge {
      inline-size: 92px;
      block-size: 92px;
    }

    .fb-trust__badge svg {
      inline-size: 44px;
      block-size: 44px;
    }
  }

  @media screen and (max-width: 599px) {
    .fb-trust__items {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Benefits bar",
  "class": "section-wrapper",
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "leaf", "label": "Leaf (natural)" },
            { "value": "gmo", "label": "Non-GMO" },
            { "value": "heart", "label": "Heart" },
            { "value": "gut", "label": "Gut health" },
            { "value": "flask", "label": "No additives" },
            { "value": "truck", "label": "Shipping" },
            { "value": "return", "label": "Returns" }
          ],
          "default": "heart"
        },
        { "type": "text", "id": "heading", "label": "Label", "default": "Benefit" }
      ]
    }
  ],
  "settings": [
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#faf7f2" },
    { "type": "color", "id": "badge_color", "label": "Icon circle", "default": "#efe5d3" },
    { "type": "color", "id": "icon_color", "label": "Icon", "default": "#000000" },
    { "type": "color", "id": "label_color", "label": "Label", "default": "#8a6a3a" },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "padding_top", "label": "Top", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 }
  ],
  "presets": [
    { "name": "Benefits bar" }
  ]
}
{% endschema %}
