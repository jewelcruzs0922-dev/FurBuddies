{%- comment -%}
  FurBuddies collection banner (portfolio demo).
  Renders the current collection's image as a wide banner.
{%- endcomment -%}

{%- assign img = collection.image | default: collection.featured_image -%}

{%- if img != blank -%}
  <div class="fb-collection-banner" style="--fb-banner-height: {{ section.settings.height }}px;">
    {{
      img
      | image_url: width: 3840
      | image_tag:
        widths: '600, 900, 1200, 1600, 2000, 2560, 3840',
        sizes: '100vw',
        class: 'fb-collection-banner__img',
        alt: collection.title,
        loading: 'eager',
        fetchpriority: 'high'
    }}
  </div>
{%- endif -%}

{% stylesheet %}
  .fb-collection-banner {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .fb-collection-banner__img {
    display: block;
    width: 100%;
    height: var(--fb-banner-height, 340px);
    object-fit: cover;
  }

  @media screen and (max-width: 749px) {
    .fb-collection-banner__img {
      height: calc(var(--fb-banner-height, 340px) * 0.6);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection banner",
  "settings": [
    {
      "type": "range",
      "id": "height",
      "label": "Banner height",
      "min": 120,
      "max": 600,
      "step": 10,
      "unit": "px",
      "default": 340
    }
  ],
  "presets": [
    { "name": "Collection banner" }
  ]
}
{% endschema %}
